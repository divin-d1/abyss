# Execution Surface Registry — common JS/TS build & lint tooling.
#
# Each [execution-surface] entry names a config file that is evaluated as
# live code (not declarative data) by its tool during normal developer
# workflows (dev/build/lint/test). Abyss uses these to raise confidence on
# findings already detected in the file — matching a surface never creates
# a finding by itself. See README.md.
#
# This file is DATA. Adding a new tool never requires recompiling Abyss.

[execution-surface]
id=nextjs.config
tool=next
patterns=next.config.js;next.config.mjs;next.config.ts
risk=executable-config
autoload=true

[execution-surface]
id=vite.config
tool=vite
patterns=vite.config.js;vite.config.ts;vite.config.mjs;vite.config.mts;vite.config.cjs
risk=executable-config
autoload=true

[execution-surface]
id=astro.config
tool=astro
patterns=astro.config.mjs;astro.config.ts;astro.config.js
risk=executable-config
autoload=true

[execution-surface]
id=eslint.config
tool=eslint
patterns=eslint.config.js;eslint.config.mjs;eslint.config.cjs;eslint.config.ts;.eslintrc.js;.eslintrc.cjs
risk=executable-config
autoload=true

[execution-surface]
id=babel.config
tool=babel
patterns=babel.config.js;babel.config.cjs;babel.config.mjs;.babelrc.js
risk=executable-config
autoload=true

[execution-surface]
id=postcss.config
tool=postcss
patterns=postcss.config.js;postcss.config.cjs;postcss.config.mjs
risk=executable-config
autoload=true

[execution-surface]
id=tailwind.config
tool=tailwind
patterns=tailwind.config.js;tailwind.config.cjs;tailwind.config.ts
risk=executable-config
autoload=true

[execution-surface]
id=webpack.config
tool=webpack
patterns=webpack.config.js;webpack.config.ts;webpack.config.cjs
risk=executable-config
autoload=true

[execution-surface]
id=rollup.config
tool=rollup
patterns=rollup.config.js;rollup.config.mjs;rollup.config.ts
risk=executable-config
autoload=true

[execution-surface]
id=jest.config
tool=jest
patterns=jest.config.js;jest.config.cjs;jest.config.mjs;jest.config.ts
risk=executable-config
autoload=false

[execution-surface]
id=vitest.config
tool=vitest
patterns=vitest.config.js;vitest.config.ts;vitest.config.mjs
risk=executable-config
autoload=false

[execution-surface]
id=electron.forge.config
tool=electron-forge
patterns=forge.config.js
risk=executable-config
autoload=true

[execution-surface]
id=npm.package.json
tool=npm
patterns=package.json
risk=lifecycle-script-manifest
autoload=true

[execution-surface]
id=vscode.tasks
tool=vscode
patterns=tasks.json
risk=auto-execution-config
autoload=true
